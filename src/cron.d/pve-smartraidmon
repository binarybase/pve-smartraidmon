# Periodically cache RAID and S.M.A.R.T. scan results for fast UI loading
SHELL=/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin

*/5 * * * * root /usr/libexec/pve-smartraidmon/smart-raid-scan summary > /var/cache/pve-smartraidmon/summary.json.tmp 2>/dev/null && mv /var/cache/pve-smartraidmon/summary.json.tmp /var/cache/pve-smartraidmon/summary.json

#!/bin/sh
set -e

case "$1" in
    configure)
        # Register API route in PVE::API2::Nodes
        NODES_PM="/usr/share/perl5/PVE/API2/Nodes.pm"
        if [ -f "$NODES_PM" ]; then
            # Work on a temp copy — original is never modified until verified
            TEMP_PM=$(mktemp /tmp/nodes_pm_XXXXXX.pm)
            cp "$NODES_PM" "$TEMP_PM"

            sed -i '/use PVE::API2::SmartRaidMon;/d' "$TEMP_PM"
            sed -i '/require PVE::API2::SmartRaidMon;/d' "$TEMP_PM"

            # Remove old SmartRaidMon blocks (paren-depth aware)
            perl - "$TEMP_PM" <<'CLEANUP_PERL'
                use strict; use warnings;
                my $file = shift;
                open my $fh, "<", $file or die "Cannot read $file: $!\n";
                my @lines = <$fh>; close $fh;
                my @out; my $i = 0;
                while ($i <= $#lines) {
                    if ($lines[$i] =~ /__PACKAGE__->register_method\s*\(/) {
                        my @block = (); my $depth = 0;
                        while ($i <= $#lines) {
                            push @block, $lines[$i];
                            for my $c (split //, $lines[$i]) {
                                $depth++ if $c eq '(';
                                $depth-- if $c eq ')';
                            }
                            $i++; last if $depth <= 0;
                        }
                        if (join('', @block) =~ /SmartRaidMon/) {
                            while ($i <= $#lines && $lines[$i] =~ /^\s*$/) { $i++; }
                            next;
                        }
                        push @out, @block;
                    } else { push @out, $lines[$i]; $i++; }
                }
                open my $ofh, ">", $file or die;
                print $ofh @out; close $ofh;
CLEANUP_PERL

            # Insert after Disks block (paren-depth aware)
            perl - "$TEMP_PM" <<'INSERT_PERL'
                use strict; use warnings;
                my $file = shift;
                open my $fh, "<", $file or die "Cannot read $file: $!\n";
                my @lines = <$fh>; close $fh;
                my $insert_after = -1;
                for my $i (0 .. $#lines) {
                    if ($lines[$i] =~ /subclass\s*=>\s*["']PVE::API2::Disks["']/) {
                        my $bs = $i;
                        for (my $k=$i; $k>=0; $k--) {
                            if ($lines[$k] =~ /__PACKAGE__->register_method\s*\(/) { $bs=$k; last; }
                        }
                        my $depth = 0;
                        for my $j ($bs .. $#lines) {
                            for my $c (split //, $lines[$j]) {
                                $depth++ if $c eq '('; $depth-- if $c eq ')';
                            }
                            if ($depth <= 0) { $insert_after = $j; last; }
                        }
                        last;
                    }
                }
                exit 1 if $insert_after < 0;
                open my $ofh, ">", $file or die;
                for my $i (0 .. $#lines) {
                    print $ofh $lines[$i];
                    if ($i == $insert_after) {
                        print $ofh "\n";
                        print $ofh "__PACKAGE__->register_method ({\n";
                        print $ofh "   subclass => \"PVE::API2::SmartRaidMon\",\n";
                        print $ofh "   path => 'smartraidmon',\n";
                        print $ofh "});\n";
                    }
                }
                close $ofh;
INSERT_PERL

            if ! grep -q "use PVE::API2::SmartRaidMon;" "$TEMP_PM"; then
                sed -i '/^use PVE::API2::Disks;/a use PVE::API2::SmartRaidMon;' "$TEMP_PM"
            fi

            if perl -c "$TEMP_PM" 2>/dev/null; then
                cp "$TEMP_PM" "$NODES_PM"
            fi
            rm -f "$TEMP_PM"
        fi

        # Patch the PVE manager index to include our JS (idempotent)
        INDEX_FILE="/usr/share/pve-manager/index.html.tpl"
        MARKER="SmartRaidMon.js"
        if [ -f "$INDEX_FILE" ] && ! grep -q "$MARKER" "$INDEX_FILE"; then
            sed -i '/<\/head>/i \    <script type="text/javascript" src="/pve2/js/SmartRaidMon.js"><\/script>' "$INDEX_FILE"
        fi

        # Restart pveproxy to pick up changes
        if systemctl is-active --quiet pveproxy; then
            systemctl restart pveproxy || true
        fi

        # Ensure cache directory exists and populate initial cache
        install -d /var/cache/pve-smartraidmon
        /usr/libexec/pve-smartraidmon/smart-raid-scan summary \
            > /var/cache/pve-smartraidmon/summary.json.tmp 2>/dev/null \
            && mv /var/cache/pve-smartraidmon/summary.json.tmp \
                  /var/cache/pve-smartraidmon/summary.json || true
        ;;
esac

#DEBHELPER#

exit 0

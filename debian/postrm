#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # Remove API route from PVE::API2::Nodes
        NODES_PM="/usr/share/perl5/PVE/API2/Nodes.pm"
        if [ -f "$NODES_PM" ]; then
            sed -i '/use PVE::API2::SmartRaidMon;/d' "$NODES_PM"
            sed -i '/require PVE::API2::SmartRaidMon;/d' "$NODES_PM"
            perl - "$NODES_PM" <<'CLEANUP_PERL'
                use strict; use warnings;
                my $file = shift;
                open my $fh, "<", $file or die "Cannot read $file: $!\n";
                my @lines = <$fh>; close $fh;
                my @out; my $i = 0;
                while ($i <= $#lines) {
                    if ($lines[$i] =~ /__PACKAGE__->register_method\s*\(/) {
                        my @block = (); my $depth = 0;
                        while ($i <= $#lines) {
                            push @block, $lines[$i];
                            for my $c (split //, $lines[$i]) {
                                $depth++ if $c eq '(';
                                $depth-- if $c eq ')';
                            }
                            $i++; last if $depth <= 0;
                        }
                        if (join('', @block) =~ /SmartRaidMon/) {
                            while ($i <= $#lines && $lines[$i] =~ /^\s*$/) { $i++; }
                            next;
                        }
                        push @out, @block;
                    } else { push @out, $lines[$i]; $i++; }
                }
                open my $ofh, ">", $file or die;
                print $ofh @out; close $ofh;
CLEANUP_PERL
        fi

        # Remove our script tag from PVE index
        INDEX_FILE="/usr/share/pve-manager/index.html.tpl"
        if [ -f "$INDEX_FILE" ]; then
            sed -i '/SmartRaidMon\.js/d' "$INDEX_FILE"
        fi

        # Remove cron job and cache
        rm -f /etc/cron.d/pve-smartraidmon
        rm -rf /var/cache/pve-smartraidmon

        # Restart pveproxy
        if systemctl is-active --quiet pveproxy; then
            systemctl restart pveproxy || true
        fi
        ;;
esac

#DEBHELPER#

exit 0

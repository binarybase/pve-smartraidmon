#!/usr/bin/perl
#
# smart-raid-scan - HP Smart Array S.M.A.R.T. scanning wrapper
#
# Scans block devices for HP Smart Array (CCISS) controllers and queries
# S.M.A.R.T. data via smartctl -d cciss,N.
#
# Usage:
#   smart-raid-scan summary              - Full summary (controllers + drives)
#   smart-raid-scan controllers          - List controllers only
#   smart-raid-scan drives               - List all drives with health overview
#   smart-raid-scan detail <dev> <port>  - Full S.M.A.R.T. detail for one drive
#   smart-raid-scan led <slot> <pd> <on|off>  - Turn drive LED on/off
#   smart-raid-scan spare <slot> <pd>         - Add drive as spare
#   smart-raid-scan unspare <slot> <pd>       - Remove drive from spare
#

use strict;
use warnings;
use JSON;

binmode(STDOUT, ':utf8');

my $SMARTCTL = '/usr/sbin/smartctl';
my $SSACLI   = '/usr/sbin/ssacli';

# ---------------------------------------------------------------------------
# Check if ssacli is available
# ---------------------------------------------------------------------------
sub ssacli_available {
    return -x $SSACLI;
}

# ---------------------------------------------------------------------------
# Parse ssacli controller list: "ssacli ctrl all show"
# Returns: [ { slot => 4, model => "Smart Array P420" }, ... ]
# ---------------------------------------------------------------------------
sub ssacli_get_controllers {
    my @lines = eval { run_cmd($SSACLI, 'ctrl', 'all', 'show') };
    return [] if $@;

    my @ctrls;
    for my $line (@lines) {
        # "Smart Array P420 in Slot 4"
        if ($line =~ /^\s*(.+?)\s+in\s+Slot\s+(\d+)/i) {
            push @ctrls, {
                model => $1,
                slot  => int($2),
            };
        }
    }
    return \@ctrls;
}

# ---------------------------------------------------------------------------
# Parse ssacli physical drive details: "ssacli ctrl slot=N pd all show detail"
# Returns: [ { serial => ..., model => ..., bay => ..., array => ..., ... }, ... ]
# ---------------------------------------------------------------------------
sub ssacli_get_drives {
    my ($slot) = @_;
    my @lines = eval { run_cmd($SSACLI, 'ctrl', "slot=$slot", 'pd', 'all', 'show', 'detail') };
    return [] if $@;

    my @drives;
    my $current_drive = undef;
    my $current_array = '';

    for my $line (@lines) {
        # "   Array A" or "   Array B"
        if ($line =~ /^\s+Array\s+([A-Z])\s*$/i) {
            $current_array = $1;
            next;
        }

        # "      physicaldrive 2I:0:1"
        if ($line =~ /^\s+physicaldrive\s+(\S+)/) {
            push @drives, $current_drive if $current_drive;
            $current_drive = {
                physicaldrive => $1,
                array         => $current_array,
            };
            next;
        }

        # Key: Value lines within a physicaldrive block
        if ($current_drive && $line =~ /^\s{9,}(\S[^:]+?):\s+(.+)$/) {
            my ($key, $val) = ($1, $2);
            $val =~ s/^\s+|\s+$//g;

            if ($key eq 'Port')            { $current_drive->{port} = $val; }
            elsif ($key eq 'Box')          { $current_drive->{box} = $val; }
            elsif ($key eq 'Bay')          { $current_drive->{bay} = $val; }
            elsif ($key eq 'Status')       { $current_drive->{status} = $val; }
            elsif ($key eq 'Drive Type')   { $current_drive->{drive_type} = $val; }
            elsif ($key eq 'Interface Type') { $current_drive->{interface_type} = $val; }
            elsif ($key eq 'Size')         { $current_drive->{size} = $val; }
            elsif ($key eq 'Serial Number') { $current_drive->{serial} = $val; }
            elsif ($key eq 'Model')        {
                $val =~ s/^ATA\s+//;  # ssacli prefixes SATA models with "ATA"
                $current_drive->{model} = $val;
            }
            elsif ($key eq 'Firmware Revision')   { $current_drive->{firmware} = $val; }
            elsif ($key eq 'Rotational Speed')     { $current_drive->{rotational_speed} = $val; }
            elsif ($key eq 'Current Temperature (C)') { $current_drive->{ssa_temperature} = "${val} C"; }
            elsif ($key eq 'Maximum Temperature (C)') { $current_drive->{max_temperature} = "${val} C"; }
            elsif ($key eq 'PHY Transfer Rate')    { $current_drive->{phy_transfer_rate} = $val; }
            elsif ($key eq 'Drive exposed to OS')  { $current_drive->{exposed_to_os} = $val; }
            elsif ($key eq 'WWID')                 { $current_drive->{wwid} = $val; }
            elsif ($key eq 'Last Failure Reason')  { $current_drive->{last_failure_reason} = $val; }
        }
    }
    push @drives, $current_drive if $current_drive;

    return \@drives;
}

# ---------------------------------------------------------------------------
# Parse ssacli logical drive info: "ssacli ctrl slot=N ld all show detail"
# Returns: [ { ld_id => 1, raid_level => '1', size => '3.6 TB', ... }, ... ]
# ---------------------------------------------------------------------------
sub ssacli_get_logical_drives {
    my ($slot) = @_;
    my @lines = eval { run_cmd($SSACLI, 'ctrl', "slot=$slot", 'ld', 'all', 'show', 'detail') };
    return [] if $@;

    my @lds;
    my $current_ld = undef;
    my $current_array = '';

    for my $line (@lines) {
        if ($line =~ /^\s+Array\s+([A-Z])\s*$/i) {
            $current_array = $1;
            next;
        }
        # "      Logical Drive: 1"
        if ($line =~ /Logical Drive:\s*(\d+)/i) {
            push @lds, $current_ld if $current_ld;
            $current_ld = {
                ld_id => int($1),
                array => $current_array,
            };
            next;
        }
        if ($current_ld && $line =~ /^\s{9,}(\S[^:]+?):\s+(.+)$/) {
            my ($key, $val) = ($1, $2);
            $val =~ s/^\s+|\s+$//g;
            if ($key eq 'Fault Tolerance') { $current_ld->{raid_level} = $val; }
            elsif ($key eq 'Size')         { $current_ld->{size} = $val; }
            elsif ($key eq 'Status')       { $current_ld->{status} = $val; }
            elsif ($key eq 'Disk Name')    { $current_ld->{disk_name} = $val; }
        }
    }
    push @lds, $current_ld if $current_ld;

    return \@lds;
}

# ---------------------------------------------------------------------------
# Build a serial-to-ssacli-info lookup from all ssacli controllers.
# Also returns enriched controller list and logical drive info.
# ---------------------------------------------------------------------------
sub ssacli_gather_all {
    my @ssa_controllers;
    my %drive_by_serial;   # serial => { bay, port, box, array, status, ... }
    my @logical_drives;
    my $total_pd_count = 0;

    my $ctrls = ssacli_get_controllers();
    for my $ctrl (@$ctrls) {
        push @ssa_controllers, $ctrl;

        my $pds = ssacli_get_drives($ctrl->{slot});
        for my $pd (@$pds) {
            $pd->{controller_model} = $ctrl->{model};
            $pd->{controller_slot}  = $ctrl->{slot};
            if ($pd->{serial}) {
                $drive_by_serial{$pd->{serial}} = $pd;
            }
            $total_pd_count++;
        }

        my $lds = ssacli_get_logical_drives($ctrl->{slot});
        for my $ld (@$lds) {
            $ld->{controller_model} = $ctrl->{model};
            $ld->{controller_slot}  = $ctrl->{slot};
            push @logical_drives, $ld;
        }
    }

    return {
        controllers    => \@ssa_controllers,
        drive_by_serial => \%drive_by_serial,
        logical_drives => \@logical_drives,
        pd_count       => $total_pd_count,
    };
}

# ---------------------------------------------------------------------------
# Utility: run a command, capture stdout, return lines
# ---------------------------------------------------------------------------
sub run_cmd {
    my (@cmd) = @_;
    my $pid = open(my $fh, '-|', @cmd);
    die "Cannot run @cmd: $!\n" unless defined $pid;
    my @lines = <$fh>;
    close($fh);
    chomp(@lines);
    return @lines;
}

# ---------------------------------------------------------------------------
# Utility: format capacity in GB from smartctl or ssacli output
#   smartctl: "4,000,787,030,016 bytes [4.00 TB]"
#   ssacli:   "4 TB", "256 GB", "480 GB"
# Returns: "3726 GB", "256 GB", etc.
# ---------------------------------------------------------------------------
sub format_capacity_gb {
    my ($raw) = @_;
    return '' unless defined $raw;

    # Try smartctl format: "N bytes [...]" — extract bytes
    if ($raw =~ /([\d,]+)\s*bytes/) {
        my $bytes = $1;
        $bytes =~ s/,//g;
        my $gb = $bytes / (1000 * 1000 * 1000);
        return sprintf("%.0f GB", $gb);
    }
    # ssacli format: "4 TB" or "256 GB"
    if ($raw =~ /([\d.]+)\s*TB/i) {
        return sprintf("%.0f GB", $1 * 1000);
    }
    if ($raw =~ /([\d.]+)\s*GB/i) {
        return sprintf("%.0f GB", $1);
    }
    return $raw;
}

# ---------------------------------------------------------------------------
# Detect block devices that sit behind an HP Smart Array (CCISS) controller.
#
# The naive approach of reading /sys/block/sdX/device/driver fails because
# that symlink points to the SCSI *disk* driver ("sd"), not the HBA driver
# ("hpsa").  Instead we use three detection methods:
#
#   1. SCSI host proc_name — /sys/class/scsi_host/hostN/proc_name == "hpsa"
#   2. hpsa-specific sysfs attributes (hp_ssd_smart_path_enabled, lunid)
#   3. Legacy cciss driver symlink (very old kernels)
# ---------------------------------------------------------------------------
sub detect_controllers {
    my %controllers;

    opendir(my $dh, '/sys/block') or die "Cannot open /sys/block: $!\n";
    my @devs = grep { /^sd[a-z]+$/ } readdir($dh);
    closedir($dh);

    for my $dev (sort @devs) {
        my $dev_dir = "/sys/block/$dev/device";
        next unless -d $dev_dir;

        my $is_hpsa = 0;
        my $driver_name = '';

        # Method 1: Check the SCSI host adapter's proc_name.
        # /sys/block/sda is a symlink containing .../hostN/... in its path.
        my $block_link = readlink("/sys/block/$dev") // '';
        if ($block_link =~ m{/host(\d+)/}) {
            my $proc_file = "/sys/class/scsi_host/host$1/proc_name";
            if (open(my $fh, '<', $proc_file)) {
                my $pname = <$fh>;
                chomp $pname;
                close($fh);
                if ($pname eq 'hpsa') {
                    $is_hpsa = 1;
                    $driver_name = 'hpsa';
                }
            }
        }

        # Method 2: hpsa exposes unique sysfs attributes on each SCSI device.
        if (!$is_hpsa && (-e "$dev_dir/hp_ssd_smart_path_enabled" || -e "$dev_dir/lunid")) {
            $is_hpsa = 1;
            $driver_name = 'hpsa';
        }

        # Method 3: Legacy cciss driver (older kernels expose it as the
        # device driver symlink).
        if (!$is_hpsa) {
            my $driver_link = "$dev_dir/driver";
            if (-l $driver_link) {
                my $driver_path = readlink($driver_link) // '';
                my ($dname) = $driver_path =~ m{/([^/]+)$};
                if ($dname && ($dname eq 'hpsa' || $dname eq 'cciss')) {
                    $is_hpsa = 1;
                    $driver_name = $dname;
                }
            }
        }

        next unless $is_hpsa;

        # Read model from sysfs if available
        my $model = '';
        my $model_file = "$dev_dir/model";
        if (open(my $mf, '<', $model_file)) {
            $model = <$mf>;
            chomp $model;
            $model =~ s/^\s+|\s+$//g;
            close($mf);
        }

        $controllers{$dev} = {
            device => $dev,
            model  => $model,
            driver => $driver_name,
        };
    }

    return \%controllers;
}

# ---------------------------------------------------------------------------
# Probe a device for drives behind CCISS by trying cciss,0 through cciss,N.
# Stops after 3 consecutive failed ports. Max 128 drives per controller.
# ---------------------------------------------------------------------------

# Known RAID controller chip models that appear as cciss devices but are not
# actual physical drives.
my %CONTROLLER_MODELS = map { lc($_) => 1 } qw(
    SRCv8x6G SRCv24x6G SRCv4x6G SRCv12x6G
);

sub probe_drives {
    my ($dev, $max_ports) = @_;
    $max_ports //= 128;  # default: probe up to 128 if no ssacli hint
    my @drives;
    my $consecutive_fail = 0;

    for my $port (0 .. ($max_ports - 1)) {
        # Single smartctl call with -a (all info) — gets device info, health,
        # attributes, error log, self-test log in one pass.
        my @output = eval {
            run_cmd($SMARTCTL, '-a', "/dev/$dev", '-d', "cciss,$port");
        };
        if ($@) {
            $consecutive_fail++;
            last if $consecutive_fail >= 3;
            next;
        }

        my $out_text = join("\n", @output);

        # If smartctl says "No such device" or returns garbage, count as failure
        if ($out_text =~ /No such device|INQUIRY failed|Smartctl open device.*failed/i) {
            $consecutive_fail++;
            last if $consecutive_fail >= 3;
            next;
        }

        # Check if we got valid device info
        unless ($out_text =~ /Device Model|Product|Vendor/i) {
            $consecutive_fail++;
            last if $consecutive_fail >= 3;
            next;
        }

        # Got a valid response — reset failure counter
        $consecutive_fail = 0;

        my %info = (
            device     => $dev,
            cciss_port => $port,
            health     => 'UNKNOWN',
        );

        # Parse basic info fields
        if ($out_text =~ /(?:Device Model|Product):\s*(.+)/i) {
            $info{model} = $1;
            $info{model} =~ s/^\s+|\s+$//g;
        }

        # Skip RAID controller chips (they respond to cciss but aren't drives)
        if ($info{model} && $CONTROLLER_MODELS{lc($info{model})}) {
            next;
        }

        if ($out_text =~ /Serial [Nn]umber:\s*(.+)/i) {
            $info{serial} = $1;
            $info{serial} =~ s/^\s+|\s+$//g;
        }
        if ($out_text =~ /User Capacity:\s*(.+)/i) {
            my $raw_cap = $1;
            $raw_cap =~ s/^\s+|\s+$//g;
            $info{capacity} = format_capacity_gb($raw_cap);
        }
        if ($out_text =~ /Firmware Version:\s*(.+)/i) {
            $info{firmware} = $1;
            $info{firmware} =~ s/^\s+|\s+$//g;
        }
        if ($out_text =~ /Rotation Rate:\s*(.+)/i) {
            $info{rotation_rate} = $1;
            $info{rotation_rate} =~ s/^\s+|\s+$//g;
        }
        if ($out_text =~ /Form Factor:\s*(.+)/i) {
            $info{form_factor} = $1;
            $info{form_factor} =~ s/^\s+|\s+$//g;
        }

        # --- Health & attributes (parsed from same output) ---

        # Health status (ATA and SAS formats)
        if ($out_text =~ /SMART (?:overall-)?health self-assessment.*?:\s*(.+)/i) {
            my $s = $1; $s =~ s/^\s+|\s+$//g;
            $info{health} = $s;
        } elsif ($out_text =~ /SMART Health Status:\s*(.+)/i) {
            my $s = $1; $s =~ s/^\s+|\s+$//g;
            $info{health} = $s;
        }

        # Temperature (ATA attribute row, then SAS format)
        if ($out_text =~ /194\s+Temperature_Celsius\s+\S+\s+\S+\s+\S+\s+\S+\s+\S+\s+\S+\s+\S+\s+(\d+)/i) {
            $info{temperature} = "${1} C";
        } elsif ($out_text =~ /Temperature_Celsius.*?(\d+)\s*(?:\(|$)/mi) {
            $info{temperature} = "${1} C";
        } elsif ($out_text =~ /Current Drive Temperature:\s*(\d+)/i) {
            $info{temperature} = "${1} C";
        }

        # Power-on hours
        # ATA: "  9 Power_On_Hours  ...  99681" — grab last number on the line
        if ($out_text =~ /^\s*9\s+Power_On_Hours\b.*\s(\d[\d,]*)\s*$/mi) {
            my $h = $1; $h =~ s/,//g;
            $info{power_on_hours} = $h;
        }
        # SAS: "Accumulated power on time, hours:minutes 62011:14"
        elsif ($out_text =~ /Accumulated power on time.*?(\d[\d,]+):\d+/mi) {
            my $h = $1; $h =~ s/,//g;
            $info{power_on_hours} = $h;
        }
        # SAS (Seagate): "number of hours powered up = 11280.67"
        elsif ($out_text =~ /number of hours powered up\s*=\s*(\d[\d,]*)/mi) {
            my $h = $1; $h =~ s/,//g;
            $info{power_on_hours} = $h;
        }

        # Reallocated sectors (ATA)
        if ($out_text =~ /Reallocated_Sector_Ct.*?(\d+)\s*$/mi) {
            $info{reallocated_sectors} = $1;
        }

        # Grown defect list (SAS — equivalent of reallocated sectors)
        if ($out_text =~ /Elements in grown defect list:\s*(\d+)/i) {
            $info{grown_defect_list} = $1;
        }

        push @drives, \%info;
    }

    return \@drives;
}

# ---------------------------------------------------------------------------
# Get full S.M.A.R.T. detail for a specific drive
# ---------------------------------------------------------------------------
sub get_drive_detail {
    my ($dev, $port) = @_;

    my @output = eval {
        run_cmd($SMARTCTL, '-a', "/dev/$dev", '-d', "cciss,$port");
    };
    die "Failed to query smartctl for /dev/$dev cciss,$port: $@\n" if $@;

    my $out_text = join("\n", @output);
    my %result = (
        health     => 'UNKNOWN',
        raw_output => $out_text,
    );

    # --- Parse device info section ---
    my %info;
    for my $field (
        'Device Model', 'Product', 'Vendor', 'Serial Number',
        'Firmware Version', 'User Capacity', 'Sector Size',
        'Rotation Rate', 'Form Factor', 'Device is',
        'ATA Version is', 'SATA Version is', 'Transport protocol',
        'Logical Unit id',
    ) {
        if ($out_text =~ /^\Q$field\E:\s*(.+)$/mi) {
            my $val = $1;
            $val =~ s/^\s+|\s+$//g;
            my $key = lc($field);
            $key =~ s/\s+/_/g;
            $info{$key} = $val;
        }
    }
    $result{info} = \%info;

    # Format capacity in GB if present
    if ($info{user_capacity}) {
        $result{info}{user_capacity} = format_capacity_gb($info{user_capacity});
    }

    # --- Parse health (ATA and SAS formats) ---
    if ($out_text =~ /SMART (?:overall-)?health self-assessment.*?:\s*(.+)/i) {
        my $h = $1;
        $h =~ s/^\s+|\s+$//g;
        $result{health} = $h;
    } elsif ($out_text =~ /SMART Health Status:\s*(.+)/i) {
        my $h = $1;
        $h =~ s/^\s+|\s+$//g;
        $result{health} = $h;
    }

    # --- Parse S.M.A.R.T. attributes ---
    my @attributes;
    # ATA-style attributes table
    while ($out_text =~ /^\s*(\d+)\s+(\S+)\s+(0x[\da-fA-F]+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(.+)$/mg) {
        push @attributes, {
            id         => int($1),
            name       => $2,
            flag       => $3,
            value      => int($4),
            worst      => int($5),
            threshold  => int($6),
            type       => $7,
            updated    => $8,
            when_failed => $9,
            raw_value  => $10,
        };
    }

    # SAS-style: look for structured data lines (vendor-specific)
    unless (@attributes) {
        # Try to parse SAS/SCSI-style parameters
        while ($out_text =~ /^\s*(read|write|verify):\s+(.+)$/mgi) {
            push @attributes, {
                name      => "Error counter: $1",
                raw_value => $2,
            };
        }

        # Parse key SAS SMART fields
        for my $pattern (
            ['Current Drive Temperature',     'temperature'],
            ['Drive Trip Temperature',        'trip_temperature'],
            ['Accumulated start-stop cycles', 'start_stop_cycles'],
            ['Accumulated load-unload cycles','load_unload_cycles'],
            ['Elements in grown defect list', 'grown_defect_list'],
            ['number of hours powered up',    'power_on_hours'],
        ) {
            if ($out_text =~ /^\s*\Q$pattern->[0]\E[:\s]+(\S+)/mi) {
                push @attributes, {
                    name      => $pattern->[1],
                    raw_value => $1,
                };
            }
        }
    }
    $result{attributes} = \@attributes;

    # --- Parse self-test log ---
    my @tests;
    while ($out_text =~ /^#\s*(\d+)\s+(.+?)\s{2,}(.+?)\s{2,}\s*(\d+)%\s+(\d+)\s+(.*?)$/mg) {
        push @tests, {
            num          => int($1),
            description  => $2,
            status       => $3,
            remaining    => int($4),
            lifetime_h   => int($5),
            lba_of_error => $6 || '-',
        };
    }
    $result{self_tests} = \@tests;

    return \%result;
}

# ---------------------------------------------------------------------------
# Group detected block devices by physical controller (SCSI host).
# Multiple logical volumes (sda, sdb) on the same controller share the same
# physical drives — we only need to probe one device per controller.
# Returns: { host0 => { devices => [sda, sdb], probe_dev => 'sda', model => ... }, ... }
# ---------------------------------------------------------------------------
sub group_by_controller {
    my ($controllers) = @_;
    my %hosts;

    for my $dev (sort keys %$controllers) {
        my $block_link = readlink("/sys/block/$dev") // '';
        my ($host) = $block_link =~ m{/(host\d+)/};
        $host //= "unknown_$dev";

        if (!$hosts{$host}) {
            $hosts{$host} = {
                devices   => [],
                probe_dev => $dev,
                model     => $controllers->{$dev}{model},
                driver    => $controllers->{$dev}{driver},
            };
        }
        push @{$hosts{$host}{devices}}, $dev;
    }

    return \%hosts;
}

# ---------------------------------------------------------------------------
# Merge ssacli info into a drive hash (matched by serial number).
# ---------------------------------------------------------------------------
sub merge_ssacli_info {
    my ($drive, $ssa_info) = @_;
    return unless $ssa_info && $drive->{serial};

    my $ssa = $ssa_info->{$drive->{serial}};
    return unless $ssa;

    # Mark as matched so we know smartctl found it
    $ssa->{_matched} = 1;

    # Add ssacli-exclusive fields
    $drive->{bay}              = $ssa->{bay}              if $ssa->{bay};
    $drive->{port}             = $ssa->{port}             if $ssa->{port};
    $drive->{box}              = $ssa->{box}              if $ssa->{box};
    $drive->{array}            = $ssa->{array}            if $ssa->{array};
    $drive->{status}           = $ssa->{status}           if $ssa->{status};
    $drive->{drive_type}       = $ssa->{drive_type}       if $ssa->{drive_type};
    $drive->{interface_type}   = $ssa->{interface_type}   if $ssa->{interface_type};
    $drive->{physicaldrive}    = $ssa->{physicaldrive}    if $ssa->{physicaldrive};
    $drive->{controller_model} = $ssa->{controller_model} if $ssa->{controller_model};
    $drive->{controller_slot}  = $ssa->{controller_slot}  if defined $ssa->{controller_slot};
    $drive->{wwid}             = $ssa->{wwid}             if $ssa->{wwid};
    $drive->{max_temperature}  = $ssa->{max_temperature}  if $ssa->{max_temperature};
    # Use ssacli temperature if smartctl didn't provide one
    $drive->{temperature}    //= $ssa->{ssa_temperature}  if $ssa->{ssa_temperature};
}

# ---------------------------------------------------------------------------
# Build drive entries for ssacli-only drives (e.g. failed drives that
# smartctl cannot reach). Returns an array ref of synthetic drive hashes.
# ---------------------------------------------------------------------------
sub ssacli_only_drives {
    my ($ssa_data, $logical_volumes) = @_;
    return [] unless $ssa_data && $ssa_data->{drive_by_serial};

    my @extra;
    for my $serial (sort keys %{$ssa_data->{drive_by_serial}}) {
        my $ssa = $ssa_data->{drive_by_serial}{$serial};
        next if $ssa->{_matched};  # already merged with a smartctl drive

        my %d = (
            device           => $logical_volumes->[0] // 'unknown',
            cciss_port       => -1,     # not reachable via smartctl
            serial           => $serial,
            health           => ($ssa->{status} && $ssa->{status} ne 'OK') ? 'FAILED' : 'UNKNOWN',
            status           => $ssa->{status}           // 'Unknown',
            model            => $ssa->{model}            // '',
            bay              => $ssa->{bay}              // '',
            port             => $ssa->{port}             // '',
            box              => $ssa->{box}              // '',
            array            => $ssa->{array}            // '',
            drive_type       => $ssa->{drive_type}       // '',
            interface_type   => $ssa->{interface_type}   // '',
            physicaldrive    => $ssa->{physicaldrive}    // '',
            controller_model => $ssa->{controller_model} // '',
            firmware         => $ssa->{firmware}         // '',
            logical_volumes  => $logical_volumes,
        );
        $d{controller_slot}  = $ssa->{controller_slot} if defined $ssa->{controller_slot};
        $d{capacity}         = format_capacity_gb($ssa->{size}) if $ssa->{size};
        $d{wwid}             = $ssa->{wwid}            if $ssa->{wwid};
        $d{temperature}      = $ssa->{ssa_temperature} if $ssa->{ssa_temperature};
        $d{max_temperature}  = $ssa->{max_temperature} if $ssa->{max_temperature};
        $d{rotation_rate}    = "$ssa->{rotational_speed} rpm" if $ssa->{rotational_speed};
        $d{last_failure_reason} = $ssa->{last_failure_reason} if $ssa->{last_failure_reason};

        push @extra, \%d;
    }
    return \@extra;
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
my $mode = $ARGV[0] // 'summary';

# Gather ssacli data once if available
my $ssa_data;
if (ssacli_available() && $mode !~ /^(detail|led|spare|unspare)$/) {
    $ssa_data = eval { ssacli_gather_all() };
    warn "ssacli error (continuing without it): $@\n" if $@;
}

if ($mode eq 'controllers') {
    my $ctrls = detect_controllers();
    my @list = values %$ctrls;
    # Enrich with ssacli controller info
    if ($ssa_data && @{$ssa_data->{controllers}}) {
        for my $ctrl (@list) {
            # Replace generic "LOGICAL VOLUME" with real controller model
            for my $sc (@{$ssa_data->{controllers}}) {
                $ctrl->{controller_model} = $sc->{model};
                $ctrl->{controller_slot}  = $sc->{slot};
            }
        }
    }
    print encode_json(\@list);
}
elsif ($mode eq 'drives') {
    my $ctrls = detect_controllers();
    my $hosts = group_by_controller($ctrls);
    # Use ssacli drive count as probe limit (+2 for controller chip + margin)
    my $max_ports = ($ssa_data && $ssa_data->{pd_count} > 0)
        ? $ssa_data->{pd_count} + 2
        : undef;
    my @all_drives;
    my @all_vols;
    for my $host (sort keys %$hosts) {
        my $h = $hosts->{$host};
        my $drives = probe_drives($h->{probe_dev}, $max_ports);
        for my $d (@$drives) {
            $d->{logical_volumes} = $h->{devices};
            merge_ssacli_info($d, $ssa_data->{drive_by_serial}) if $ssa_data;
            push @all_drives, $d;
        }
        push @all_vols, @{$h->{devices}};
    }
    # Append drives only visible to ssacli (e.g. failed drives)
    if ($ssa_data) {
        my $extra = ssacli_only_drives($ssa_data, \@all_vols);
        push @all_drives, @$extra;
    }
    print encode_json(\@all_drives);
}
elsif ($mode eq 'detail') {
    my $dev  = $ARGV[1] // die "Usage: smart-raid-scan detail <device> <port>\n";
    my $port = $ARGV[2] // die "Usage: smart-raid-scan detail <device> <port>\n";

    # Strict input validation
    die "Invalid device name\n" unless $dev =~ /^[a-z]{2,4}[a-z]$/;
    die "Invalid port number\n" unless $port =~ /^\d+$/ && $port >= 0 && $port <= 127;

    my $detail = get_drive_detail($dev, $port);
    print encode_json($detail);
}
elsif ($mode eq 'summary') {
    my $ctrls = detect_controllers();
    my @ctrl_list = values %$ctrls;
    my $hosts = group_by_controller($ctrls);

    # Enrich controllers with ssacli info
    if ($ssa_data && @{$ssa_data->{controllers}}) {
        for my $ctrl (@ctrl_list) {
            for my $sc (@{$ssa_data->{controllers}}) {
                $ctrl->{controller_model} = $sc->{model};
                $ctrl->{controller_slot}  = $sc->{slot};
            }
        }
    }

    my $max_ports = ($ssa_data && $ssa_data->{pd_count} > 0)
        ? $ssa_data->{pd_count} + 2
        : undef;
    my @all_drives;
    my @all_vols;
    for my $host (sort keys %$hosts) {
        my $h = $hosts->{$host};
        my $drives = probe_drives($h->{probe_dev}, $max_ports);
        for my $d (@$drives) {
            $d->{logical_volumes} = $h->{devices};
            merge_ssacli_info($d, $ssa_data->{drive_by_serial}) if $ssa_data;
            push @all_drives, $d;
        }
        push @all_vols, @{$h->{devices}};
    }
    # Append drives only visible to ssacli (e.g. failed drives)
    if ($ssa_data) {
        my $extra = ssacli_only_drives($ssa_data, \@all_vols);
        push @all_drives, @$extra;
    }

    my %result = (
        controllers => \@ctrl_list,
        drives      => \@all_drives,
    );
    # Include logical drive info if ssacli provided it
    if ($ssa_data && @{$ssa_data->{logical_drives}}) {
        $result{logical_drives} = $ssa_data->{logical_drives};
    }

    print encode_json(\%result);
}
elsif ($mode eq 'led') {
    my $slot   = $ARGV[1] // die "Usage: smart-raid-scan led <slot> <pd> <on|off>\n";
    my $pd     = $ARGV[2] // die "Usage: smart-raid-scan led <slot> <pd> <on|off>\n";
    my $action = $ARGV[3] // die "Usage: smart-raid-scan led <slot> <pd> <on|off>\n";

    die "Invalid slot\n" unless $slot =~ /^\d+$/;
    die "Invalid physicaldrive\n" unless $pd =~ /^[\dA-Za-z]+:[\dA-Za-z]+:[\dA-Za-z]+$/;
    die "Invalid action (must be on or off)\n" unless $action =~ /^(on|off)$/;

    die "ssacli not available\n" unless ssacli_available();
    my @out = run_cmd($SSACLI, 'ctrl', "slot=$slot", 'pd', $pd, 'modify', "led=$action");
    print encode_json({ success => 1, message => "LED $action for $pd" });
}
elsif ($mode eq 'spare') {
    my $slot = $ARGV[1] // die "Usage: smart-raid-scan spare <slot> <pd>\n";
    my $pd   = $ARGV[2] // die "Usage: smart-raid-scan spare <slot> <pd>\n";

    die "Invalid slot\n" unless $slot =~ /^\d+$/;
    die "Invalid physicaldrive\n" unless $pd =~ /^[\dA-Za-z]+:[\dA-Za-z]+:[\dA-Za-z]+$/;

    die "ssacli not available\n" unless ssacli_available();
    my @out = run_cmd($SSACLI, 'ctrl', "slot=$slot", 'array', 'all', 'add', "spares=$pd");
    print encode_json({ success => 1, message => "Drive $pd added as spare" });
}
elsif ($mode eq 'unspare') {
    my $slot = $ARGV[1] // die "Usage: smart-raid-scan unspare <slot> <pd>\n";
    my $pd   = $ARGV[2] // die "Usage: smart-raid-scan unspare <slot> <pd>\n";

    die "Invalid slot\n" unless $slot =~ /^\d+$/;
    die "Invalid physicaldrive\n" unless $pd =~ /^[\dA-Za-z]+:[\dA-Za-z]+:[\dA-Za-z]+$/;

    die "ssacli not available\n" unless ssacli_available();
    my @out = run_cmd($SSACLI, 'ctrl', "slot=$slot", 'array', 'all', 'remove', "spares=$pd");
    print encode_json({ success => 1, message => "Drive $pd removed from spare" });
}
else {
    die "Unknown mode: $mode\nUsage: smart-raid-scan [summary|controllers|drives|detail|led|spare|unspare]\n";
}

exit 0;

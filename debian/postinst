#!/bin/sh
set -e

case "$1" in
    configure)
        # Register API route in PVE::API2::Nodes
        NODES_PM="/usr/share/perl5/PVE/API2/Nodes.pm"
        if [ -f "$NODES_PM" ]; then
            # Clean any previous registration first
            sed -i '/use PVE::API2::SmartRaidMon;/d' "$NODES_PM"
            sed -i '/require PVE::API2::SmartRaidMon;/d' "$NODES_PM"
            perl -0777 -i -pe 's/\n*__PACKAGE__->register_method\s*\(\{[^}]*SmartRaidMon[^}]*\}\);\n*//gs' "$NODES_PM"

            # Insert registration after PVE::API2::Disks registration block
            # (in the PVE::API2::Nodes::Nodeinfo package context).
            perl -e '
                use strict; use warnings;
                my $file = shift;
                open my $fh, "<", $file or die "Cannot read $file: $!\n";
                my @lines = <$fh>; close $fh;
                my $insert_after = -1;
                for my $i (0 .. $#lines) {
                    if ($lines[$i] =~ /subclass\s*=>\s*"PVE::API2::Disks"/) {
                        for my $j ($i .. $#lines) {
                            if ($lines[$j] =~ /^\}\);/) {
                                $insert_after = $j; last;
                            }
                        }
                        last;
                    }
                }
                exit 1 if $insert_after < 0;
                open my $out, ">", $file or die "Cannot write $file: $!\n";
                for my $i (0 .. $#lines) {
                    print $out $lines[$i];
                    if ($i == $insert_after) {
                        print $out "\n__PACKAGE__->register_method({\n";
                        print $out "    subclass => \"PVE::API2::SmartRaidMon\",\n";
                        print $out "    path => \"smartraidmon\",\n";
                        print $out "});\n";
                    }
                }
                close $out;
            ' "$NODES_PM"
            # Add use statement after use PVE::API2::Disks line
            if ! grep -q "use PVE::API2::SmartRaidMon;" "$NODES_PM"; then
                sed -i '/^use PVE::API2::Disks;/a use PVE::API2::SmartRaidMon;' "$NODES_PM"
            fi
        fi

        # Patch the PVE manager index to include our JS (idempotent)
        INDEX_FILE="/usr/share/pve-manager/index.html.tpl"
        MARKER="SmartRaidMon.js"
        if [ -f "$INDEX_FILE" ] && ! grep -q "$MARKER" "$INDEX_FILE"; then
            sed -i '/<\/head>/i \    <script type="text/javascript" src="/pve2/js/SmartRaidMon.js"><\/script>' "$INDEX_FILE"
        fi

        # Restart pveproxy to pick up changes
        if systemctl is-active --quiet pveproxy; then
            systemctl restart pveproxy || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
